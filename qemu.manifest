<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- UTF-8 process codepage (Windows 10 1809+): the virtio-9p Windows backend
       serves shared-folder filenames through narrow-character ANSI APIs, so on
       non-UTF-8 locales (e.g. zh-CN / GBK) non-ASCII names reach the guest as
       mojibake. Declaring activeCodePage=UTF-8 here makes the process use
       CP_UTF-8 and fixes it at the source. See issue #4. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
