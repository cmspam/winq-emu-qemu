#include <winver.h>
#include "config-host.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION QEMU_VERSION_MAJOR,QEMU_VERSION_MINOR,QEMU_VERSION_MICRO,0
PRODUCTVERSION QEMU_VERSION_MAJOR,QEMU_VERSION_MINOR,QEMU_VERSION_MICRO,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904E4"
    {
      VALUE "CompanyName", "WINQ-EMU Project"
      VALUE "FileDescription", "WINQ-EMU - GPU-Accelerated Linux VM for Windows"
      VALUE "FileVersion", QEMU_VERSION
      VALUE "LegalCopyright", "Copyright WINQ-EMU Project and QEMU contributors. GPL-2.0-or-later."
      VALUE "ProductName", "WINQ-EMU"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x0409, 1252
  }
}

IDI_ICON1 ICON "pc-bios/winq-emu.ico"

/* Embedded application manifest. 24 = RT_MANIFEST. The UTF-8 activeCodePage
 * fixes virtio-9p non-ASCII (e.g. Chinese) filenames on non-UTF-8 ANSI-locale
 * Windows hosts -- see issue #4. Must be embedded (an external
 * qemu.exe.manifest file has lower priority than the embedded one). */
1 24 "qemu.manifest"
